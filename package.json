  "license": "MIT",
  "dependencies": {
    "anchor-lib": "^0.0.1",
    "call-func": "^0.5.3",
    "get-storage": "^0.3.2",
    "object-nested": "^0.2.0",
    "organism-react-ajax": "^0.17.20",
    "parse-ini-string": "^0.2.0",
    "pmvc_react_portfolio": "^0.4.15",
    "react-atomic-molecule": "^5.7.0",
    "react-atomic-organism": "^0.16.36",
    "react-github-calendar": "^5.0.9",
    "reshow-url": "^0.19.2",
    "ricon": "^0.5.4",
    "seturl": "^0.7.1",
    "win-doc": "^0.4.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reshow-app": "^0.18.11",
    "swc-loader": "^0.2.7",
    "typescript": "^7.0.2",
    "use-hdm-cli": "^0.1.1"
  },
  "scripts": {
    "update-compile-sh": "yo reshow:compile-sh",
    "webpack": "webpack",
    "start": "ws",
    "format": "prettier-eslint --write 'src/**/*.{ts,tsx}'",
    "clean:webpack": "find ./assets -name '*.*' | xargs rm -rf && rm -rf workbox-*.js",
    "clean": "find ./build -name '*.*' | xargs rm -rf",
    "build:es": "BABEL_ENV=es babel src -d build/es/src --extensions '.js,.jsx,.ts,.tsx' --ignore '**/*.d.ts' --out-file-extension .mjs",
    "build": "npm run clean && npm run build:es",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:e2e",
    "test:e2e": "bun scripts/e2e.ts"
  }
}
