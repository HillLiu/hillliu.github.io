{
  "private": true,
  "description": "Freelancer theme base on react",
  "keywords": [
    "react",
    "reactjs"
  ],
  "author": "Hill <hill@kimo.com>",
  "license": "MIT",
  "dependencies": {
    "call-func": "*",
    "get-storage": "*",
    "object-nested": "*",
    "organism-react-ajax": "*",
    "parse-ini-string": "*",
    "pmvc_react_portfolio": "*",
    "react-atomic-molecule": "*",
    "react-atomic-organism": "*",
    "react-github-calendar": "3.3.1",
    "reshow-url": "*",
    "ricon": "*",
    "seturl": "*",
    "win-doc": "*"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.18.6",
    "react": "^18.x",
    "react-dom": "^18.x",
    "reshow-app": "*",
    "swc-loader": "^0.2.3",
    "typescript": "^5.6.0",
    "use-hdm-cli": "^0.1.0"
  },
  "scripts": {
    "update-compile-sh": "yo reshow:compile-sh",
    "webpack": "webpack",
    "start": "ws",
    "format": "prettier-eslint --write 'src/**/*.{ts,tsx}'",
    "clean:webpack": "find ./assets -name '*.*' | xargs rm -rf && rm -rf workbox-*.js",
    "clean": "find ./build -name '*.*' | xargs rm -rf",
    "build:es": "BABEL_ENV=es babel src -d build/es/src --extensions '.js,.jsx,.ts,.tsx' --ignore '**/*.d.ts' --out-file-extension .mjs",
    "build": "npm run clean && npm run build:es",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:e2e",
    "test:e2e": "bun scripts/e2e.ts"
  }
}
